CC := gcc
CFLAGS := -std=c99 -Wall -Wextra -Werror -g -O0
INCLUDES := -Iapp_modbus_stubs -I../App/inc -Iunity
TARGET ?= /tmp/industrial_app_config_test
SOURCES := ../App/src/app_config.c unity/unity.c test_app_config.c

.PHONY: test
test:
	$(CC) $(CFLAGS) $(INCLUDES) $(SOURCES) -o $(TARGET)
	$(TARGET)
